[node name="Text" type="RichTextLabel" parent="HowToPlay/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 340)
bbcode_enabled = true
text = "[b]SURVIVORS[/b] complete tasks around the facility and try to find the ZOMBIE hiding among them.

[b]ZOMBIE[/b] blends in, secretly attacks or infects Survivors, and wins once Zombies equal or outnumber Survivors.

[b]Controls:[/b] WASD move, E interact/report, Q zombie ability, F emergency meeting.

Find a body? Press E near it to report. Suspicious behavior? Call an emergency meeting and vote them out - but choose carefully, a wrong guess helps the Zombie."

[node name="CloseButton" type="Button" parent="HowToPlay/Panel/VBox"]
layout_mode = 2
text = "Close"

