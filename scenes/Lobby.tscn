[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Lobby.gd" id="1"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.08, 0.08, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 30.0
offset_top = 20.0
offset_right = -30.0
offset_bottom = -20.0

[node name="RoomCodeLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.9, 0.6, 0.2, 1)
text = "Room Code: -"

[node name="HBox" type="HBoxContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="PlayerList" type="VBoxContainer" parent="VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CountLabel" type="Label" parent="VBox/HBox/PlayerList"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Players: 0 / 7"

[node name="SettingsPanel" type="VBoxContainer" parent="VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SettingsTitle" type="Label" parent="VBox/HBox/SettingsPanel"]
layout_mode = 2
text = "Host Settings"

[node name="MaxPlayersRow" type="HBoxContainer" parent="VBox/HBox/SettingsPanel"]
layout_mode = 2

[node name="Label" type="Label" parent="VBox/HBox/SettingsPanel/MaxPlayersRow"]
layout_mode = 2
text = "Max Players"

[node name="Slider" type="HSlider" parent="VBox/HBox/SettingsPanel/MaxPlayersRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1
max_value = 10
step = 1
value = 7

[node name="Value" type="Label" parent="VBox/HBox/SettingsPanel/MaxPlayersRow"]
layout_mode = 2
text = "7"

[node name="MultiZombieCheck" type="CheckBox" parent="VBox/HBox/SettingsPanel"]
layout_mode = 2
text = "Allow 2 Zombies (8-10 players)"

[node name="InfectionCheck" type="CheckBox" parent="VBox/HBox/SettingsPanel"]
layout_mode = 2
button_pressed = true
text = "Infection Mode"

[node name="RevealCheck" type="CheckBox" parent="VBox/HBox/SettingsPanel"]
layout_mode = 2
button_pressed = true
text = "Reveal Role on Elimination"

[node name="StartButton" type="Button" parent="VBox"]
layout_mode = 2
text = "START GAME"

[node name="StatusLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.3, 0.3, 1)

[node name="LeaveButton" type="Button" parent="VBox"]
layout_mode = 2
text = "Leave Lobby"

[connection signal="value_changed" from="VBox/HBox/SettingsPanel/MaxPlayersRow/Slider" to="." method="_on_max_players_changed"]
[connection signal="toggled" from="VBox/HBox/SettingsPanel/MultiZombieCheck" to="." method="_on_multi_zombie_toggled"]
[connection signal="toggled" from="VBox/HBox/SettingsPanel/InfectionCheck" to="." method="_on_infection_toggled"]
[connection signal="toggled" from="VBox/HBox/SettingsPanel/RevealCheck" to="." method="_on_reveal_toggled"]
[connection signal="pressed" from="VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="VBox/LeaveButton" to="." method="_on_leave_pressed"]
