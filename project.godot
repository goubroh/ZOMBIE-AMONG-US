; Engine configuration file.
; Open this folder in Godot 4.x (4.2+) via "Import" to load the project.

config_version=5

[application]

config/name="Zombie Among Us"
config/description="Trust No One. Survive the Infection. - Original social deduction / zombie survival multiplayer game."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]

Net="*res://scripts/autoload/Net.gd"
GameState="*res://scripts/autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation="landscape"

